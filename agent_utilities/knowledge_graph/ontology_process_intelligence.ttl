@prefix : <http://knuckles.team/kg#> .
@prefix bfo: <http://purl.obolibrary.org/obo/BFO_> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://knuckles.team/kg/process_intelligence> a owl:Ontology ;
    rdfs:label "Object-Centric Process and Neural Graph Intelligence Ontology" ;
    rdfs:comment """CONCEPT:AU-KG.ingest.semantic-event-contract — canonical OCEL-shaped
    event/object truth, temporal Event Knowledge Graph state, process perspectives,
    and governed neural graph proposals. Symbolic source truth remains authoritative;
    neural outputs are proposal-only until the existing review lifecycle accepts them.""" ;
    owl:imports <http://knuckles.team/kg> .

:ObjectCentricEventLog a owl:Class ;
    rdfs:label "Object-Centric Event Log" ;
    rdfs:comment "A versioned lossless event/object source slice; trace projections are derived views." ;
    rdfs:subClassOf prov:Entity,
        [ a owl:Restriction ;
          owl:onProperty :ocelHasEvent ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty :ocelHasObject ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

:ProcessEvent a owl:Class ;
    rdfs:label "Process Event" ;
    rdfs:comment "A source event with immutable identity, activity, event time, attributes, and qualified object participation." ;
    rdfs:subClassOf :Event,
        prov:Activity,
        [ a owl:Restriction ;
          owl:onProperty :HAS_PARTICIPATION ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

:BusinessObject a owl:Class ;
    rdfs:label "Business Object" ;
    rdfs:comment "A source-qualified independent continuant participating in one or more process events." ;
    rdfs:subClassOf bfo:0000004 .

:EventObjectParticipation a owl:Class ;
    rdfs:label "Event-Object Participation" ;
    rdfs:comment "A reified qualified OCEL event-to-object relation." ;
    rdfs:subClassOf bfo:0000020,
        [ a owl:Restriction ;
          owl:onProperty :PARTICIPATES_AS ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] .

:ObjectRelationship a owl:Class ;
    rdfs:label "Object Relationship" ;
    rdfs:comment "A reified qualified and optionally temporal OCEL object-to-object relation." ;
    rdfs:subClassOf bfo:0000020,
        [ a owl:Restriction ;
          owl:onProperty :RELATION_SOURCE ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty :RELATION_TARGET ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] .

:ObjectState a owl:Class ;
    rdfs:label "Object State" ;
    rdfs:comment "An immutable, bitemporal snapshot of a BusinessObject's attributes." ;
    rdfs:subClassOf prov:Entity,
        [ a owl:Restriction ;
          owl:onProperty :STATE_OF ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] .

:ProcessPerspective a owl:Class ;
    rdfs:label "Process Perspective" ;
    rdfs:comment "A versioned selection of object types, qualifiers, temporal bounds, and derivation policy for one analytical question." ;
    rdfs:subClassOf :Concept .

:ProcessModelVersion a owl:Class ;
    rdfs:label "Process Model Version" ;
    rdfs:comment "A reproducible DFG, BPMN, OC-Petri-net, or other process model bound to a perspective and data version." ;
    rdfs:subClassOf :ProcessModel,
        prov:Entity .

:ConformanceRun a owl:Class ;
    rdfs:label "Conformance Run" ;
    rdfs:comment "A versioned comparison of a process model with a frozen object-centric data slice." ;
    rdfs:subClassOf prov:Activity .

:Deviation a owl:Class ;
    rdfs:label "Process Deviation" ;
    rdfs:comment "Evidence-backed behavioral, participation, state, or temporal deviation found by a ConformanceRun." ;
    rdfs:subClassOf prov:Entity .

:ExtractionRun a owl:Class ;
    rdfs:label "Extraction Run" ;
    rdfs:comment "A deterministic or learned extraction execution bound to input hash, schema version, thresholds, and metrics." ;
    rdfs:subClassOf prov:Activity .

:NeuralRepresentation a owl:Class ;
    rdfs:label "Neural Representation" ;
    rdfs:comment "A versioned latent representation artifact attached to symbolic graph truth." ;
    rdfs:subClassOf prov:Entity,
        [ a owl:Restriction ;
          owl:onProperty [ owl:inverseOf :HAS_NEURAL_REPRESENTATION ] ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ] .

:NeuralRelationPrediction a owl:Class ;
    rdfs:label "Neural Relation Prediction" ;
    rdfs:comment "A calibrated missing-relation candidate; never an asserted fact without governed review." ;
    rdfs:subClassOf prov:Entity,
        [ a owl:Restriction ;
          owl:onProperty :PREDICTS_SUBJECT ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty :PREDICTS_OBJECT ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty :decision_status ;
          owl:hasValue "proposed" ] .

:EntityResolutionProposal a owl:Class ;
    rdfs:label "Entity Resolution Proposal" ;
    rdfs:comment "An ambiguous mention-to-entity candidate carrying blocking evidence and calibrated score." ;
    rdfs:subClassOf prov:Entity,
        [ a owl:Restriction ;
          owl:onProperty :PROPOSES_RESOLUTION ;
          owl:cardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
          owl:onProperty :decision_status ;
          owl:hasValue "proposed" ] .

:ocelHasEvent a owl:ObjectProperty ;
    rdfs:label "has OCEL event" ;
    rdfs:domain :ObjectCentricEventLog ;
    rdfs:range :ProcessEvent .

:ocelHasObject a owl:ObjectProperty ;
    rdfs:label "has OCEL object" ;
    rdfs:domain :ObjectCentricEventLog ;
    rdfs:range :BusinessObject .

:hasParticipation a owl:ObjectProperty ;
    rdfs:label "has participation" ;
    rdfs:domain :ProcessEvent ;
    rdfs:range :EventObjectParticipation .

:participatesAs a owl:ObjectProperty ;
    rdfs:label "participates as" ;
    rdfs:domain :EventObjectParticipation ;
    rdfs:range :BusinessObject .

:relationSource a owl:ObjectProperty ;
    rdfs:label "relation source" ;
    rdfs:domain :ObjectRelationship ;
    rdfs:range :BusinessObject .

:relationTarget a owl:ObjectProperty ;
    rdfs:label "relation target" ;
    rdfs:domain :ObjectRelationship ;
    rdfs:range :BusinessObject .

:stateOf a owl:ObjectProperty ;
    rdfs:label "state of" ;
    rdfs:domain :ObjectState ;
    rdfs:range :BusinessObject .

:observedAtState a owl:ObjectProperty ;
    rdfs:label "observed at state" ;
    rdfs:comment "Links an event to the valid object state selected as of event time." ;
    rdfs:domain :ProcessEvent ;
    rdfs:range :ObjectState .

:directlyFollows a owl:ObjectProperty ;
    rdfs:label "directly follows" ;
    rdfs:comment "A rebuildable object/perspective-qualified process derivation, never source truth." ;
    rdfs:domain :ProcessEvent ;
    rdfs:range :ProcessEvent .

:hasNeuralRepresentation a owl:ObjectProperty ;
    rdfs:label "has neural representation" ;
    owl:inverseOf :representationOf ;
    rdfs:range :NeuralRepresentation .

:representationOf a owl:ObjectProperty ;
    rdfs:label "representation of" ;
    rdfs:domain :NeuralRepresentation .

:predictsSubject a owl:ObjectProperty ;
    rdfs:label "predicts subject" ;
    rdfs:domain :NeuralRelationPrediction .

:predictsObject a owl:ObjectProperty ;
    rdfs:label "predicts object" ;
    rdfs:domain :NeuralRelationPrediction .

:proposesResolution a owl:ObjectProperty ;
    rdfs:label "proposes resolution" ;
    rdfs:domain :EntityResolutionProposal .

:derivedFromExtractionRun a owl:ObjectProperty ;
    rdfs:label "derived from extraction run" ;
    rdfs:range :ExtractionRun .

:calibratedBy a owl:ObjectProperty ;
    rdfs:label "calibrated by" ;
    rdfs:domain :NeuralRelationPrediction ;
    rdfs:range prov:Entity .

:requiresReview a owl:ObjectProperty ;
    rdfs:label "requires review" ;
    rdfs:domain prov:Entity .

# LPG/RDF boundary aliases. ChangeEnvelope uses stable UPPER_SNAKE edge names;
# declaring them explicitly prevents the executable graph and semantic vocabulary
# from drifting while preserving the human-readable properties above.
:HAS_EVENT a owl:ObjectProperty ;
    owl:equivalentProperty :ocelHasEvent .

:HAS_OBJECT a owl:ObjectProperty ;
    owl:equivalentProperty :ocelHasObject .

:HAS_PARTICIPATION a owl:ObjectProperty ;
    owl:equivalentProperty :hasParticipation .

:PARTICIPATES_AS a owl:ObjectProperty ;
    owl:equivalentProperty :participatesAs .

:RELATION_SOURCE a owl:ObjectProperty ;
    owl:equivalentProperty :relationSource .

:RELATION_TARGET a owl:ObjectProperty ;
    owl:equivalentProperty :relationTarget .

:STATE_OF a owl:ObjectProperty ;
    owl:equivalentProperty :stateOf .

:OBSERVED_AT_STATE a owl:ObjectProperty ;
    owl:equivalentProperty :observedAtState .

:DIRECTLY_FOLLOWS a owl:ObjectProperty ;
    owl:equivalentProperty :directlyFollows .

:HAS_NEURAL_REPRESENTATION a owl:ObjectProperty ;
    owl:equivalentProperty :hasNeuralRepresentation .

:PREDICTS_SUBJECT a owl:ObjectProperty ;
    owl:equivalentProperty :predictsSubject .

:PREDICTS_OBJECT a owl:ObjectProperty ;
    owl:equivalentProperty :predictsObject .

:PROPOSES_RESOLUTION a owl:ObjectProperty ;
    owl:equivalentProperty :proposesResolution .

:processOccurredAt a owl:DatatypeProperty ;
    rdfs:label "process occurred at" ;
    rdfs:domain :ProcessEvent ;
    rdfs:range xsd:dateTime .

:participationQualifier a owl:DatatypeProperty ;
    rdfs:label "participation qualifier" ;
    rdfs:range xsd:string .

:objectTypeName a owl:DatatypeProperty ;
    rdfs:label "object type name" ;
    rdfs:range xsd:string .

:sourceRecordId a owl:DatatypeProperty ;
    rdfs:label "source record identifier" ;
    rdfs:range xsd:string .

:mappingVersion a owl:DatatypeProperty ;
    rdfs:label "mapping version" ;
    rdfs:range xsd:string .

:sourceGraphEpoch a owl:DatatypeProperty ;
    rdfs:label "source graph epoch" ;
    rdfs:domain :NeuralRepresentation ;
    rdfs:range xsd:nonNegativeInteger .

:encoderId a owl:DatatypeProperty ;
    rdfs:label "encoder identifier" ;
    rdfs:domain :NeuralRepresentation ;
    rdfs:range xsd:string .

:encoderVersion a owl:DatatypeProperty ;
    rdfs:label "encoder version" ;
    rdfs:domain :NeuralRepresentation ;
    rdfs:range xsd:string .

:representationDimension a owl:DatatypeProperty ;
    rdfs:label "representation dimension" ;
    rdfs:domain :NeuralRepresentation ;
    rdfs:range xsd:positiveInteger .

:artifactRef a owl:DatatypeProperty ;
    rdfs:label "artifact reference" ;
    rdfs:domain :NeuralRepresentation ;
    rdfs:range xsd:string .

:predictionScore a owl:DatatypeProperty ;
    rdfs:label "prediction score" ;
    rdfs:domain :NeuralRelationPrediction ;
    rdfs:range xsd:decimal .

:predictionUncertainty a owl:DatatypeProperty ;
    rdfs:label "prediction uncertainty" ;
    rdfs:domain :NeuralRelationPrediction ;
    rdfs:range xsd:decimal .

:candidateSetRef a owl:DatatypeProperty ;
    rdfs:label "candidate set reference" ;
    rdfs:domain :NeuralRelationPrediction ;
    rdfs:range xsd:string .

:decisionStatus a owl:DatatypeProperty ;
    rdfs:label "decision status" ;
    rdfs:range xsd:string .

# Raw ChangeEnvelope property aliases. Shapes target these executable names;
# OWL clients may use either spelling without losing meaning.
:occurred_at a owl:DatatypeProperty ;
    owl:equivalentProperty :processOccurredAt .

:qualifier a owl:DatatypeProperty ;
    owl:equivalentProperty :participationQualifier .

:object_type a owl:DatatypeProperty ;
    owl:equivalentProperty :objectTypeName .

:source_record_id a owl:DatatypeProperty ;
    owl:equivalentProperty :sourceRecordId .

:mapping_version a owl:DatatypeProperty ;
    owl:equivalentProperty :mappingVersion .

:source_graph_epoch a owl:DatatypeProperty ;
    owl:equivalentProperty :sourceGraphEpoch .

:encoder_id a owl:DatatypeProperty ;
    owl:equivalentProperty :encoderId .

:encoder_version a owl:DatatypeProperty ;
    owl:equivalentProperty :encoderVersion .

:dimension a owl:DatatypeProperty ;
    owl:equivalentProperty :representationDimension .

:artifact_ref a owl:DatatypeProperty ;
    owl:equivalentProperty :artifactRef .

:prediction_score a owl:DatatypeProperty ;
    owl:equivalentProperty :predictionScore .

:prediction_uncertainty a owl:DatatypeProperty ;
    owl:equivalentProperty :predictionUncertainty .

:candidate_set_ref a owl:DatatypeProperty ;
    owl:equivalentProperty :candidateSetRef .

:decision_status a owl:DatatypeProperty ;
    owl:equivalentProperty :decisionStatus .

:valid_from a owl:DatatypeProperty ;
    owl:equivalentProperty :validFrom .

:valid_to a owl:DatatypeProperty ;
    owl:equivalentProperty :validTo .

:observed_at a owl:DatatypeProperty ;
    owl:equivalentProperty :observedAt .
