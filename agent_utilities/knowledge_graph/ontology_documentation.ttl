@prefix : <http://knuckles.team/kg#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Governed documentation is a projection of repository Markdown, not a second
# authoring surface (CONCEPT:AU-KG.ingest.governed-documentation-projection).
:DocumentationPage a owl:Class ;
    rdfs:label "Governed documentation page" ;
    rdfs:comment "A metadata-only projection of a repository-relative Markdown page. The authoring source remains authoritative." ;
    rdfs:subClassOf :Document .

:DocumentationRevision a owl:Class ;
    rdfs:label "Documentation revision" ;
    rdfs:comment "One exact source revision and digest of a DocumentationPage." ;
    rdfs:subClassOf prov:Entity .

:DocumentationEvidence a owl:Class ;
    rdfs:label "Documentation provenance evidence" ;
    rdfs:comment "Privacy-safe provenance for a documentation revision. It carries references and digests, never the Markdown body." ;
    rdfs:subClassOf prov:Entity .

:repositoryId a owl:DatatypeProperty ;
    rdfs:domain :DocumentationPage ;
    rdfs:range xsd:string .

:sourcePath a owl:DatatypeProperty ;
    rdfs:domain :DocumentationPage ;
    rdfs:range xsd:string .

:sourceRevision a owl:DatatypeProperty ;
    rdfs:domain :DocumentationRevision ;
    rdfs:range xsd:string .

:contentDigest a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:conceptIds a owl:DatatypeProperty ;
    rdfs:domain :DocumentationPage ;
    rdfs:range xsd:string .

:lifecycleState a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:current a owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

:deprecated a owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

:archived a owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

:supersededBy a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:validFrom a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

:validUntil a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

:recordedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

:sourceRef a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:evidenceId a owl:DatatypeProperty ;
    rdfs:domain :DocumentationEvidence ;
    rdfs:range xsd:string .

:revisionId a owl:DatatypeProperty ;
    rdfs:domain :DocumentationEvidence ;
    rdfs:range xsd:string .

:aclVerified a owl:DatatypeProperty ;
    rdfs:domain :DocumentationPage ;
    rdfs:range xsd:boolean .

:aclBeforeRetrieval a owl:DatatypeProperty ;
    rdfs:domain :DocumentationPage ;
    rdfs:range xsd:boolean .

:tombstoneVerified a owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

:snapshotDigest a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:hasDocumentationRevision a owl:ObjectProperty ;
    rdfs:domain :DocumentationPage ;
    rdfs:range :DocumentationRevision .

:hasDocumentationEvidence a owl:ObjectProperty ;
    rdfs:domain :DocumentationRevision ;
    rdfs:range :DocumentationEvidence .

<http://knuckles.team/kg/documentation> a owl:Ontology ;
    rdfs:label "Governed documentation projection ontology" ;
    rdfs:comment "Metadata-only Markdown projection with source revision, digest, provenance, lifecycle and temporal state." ;
    owl:imports <http://knuckles.team/kg> .
