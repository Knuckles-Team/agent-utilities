          "semantic_knowledge",
          "semantic_claim",
          "semantic_relationship",
          "semantic_evidence",
          "work_lease",
          "work_fence",
          "work_retry",
          "vector_payload",
          "observability_payload",
          "secret_material"
        ]
      },
      {
        "id": "vector_store",
        "kind": "tenant_graph_vector_store",
        "authority": "vector_payload",
        "authoritative_classes": ["vector_payload"],
        "prohibited_classes": [
          "identity",
          "lifecycle",
          "version",
          "release",
          "policy",
          "approval",
          "configuration",
          "quota",
          "idempotency",
          "outbox",
          "audit_reference",
          "semantic_knowledge",
          "semantic_claim",
          "semantic_relationship",
          "semantic_evidence",
          "work_lease",
          "work_fence",
          "work_retry",
          "artifact_payload",
          "observability_payload",
          "secret_material"
        ]
      },
      {
        "id": "observability_store",
        "kind": "metrics_trace_log_store",
        "authority": "observability_payload",
        "authoritative_classes": ["observability_payload"],
        "prohibited_classes": [
          "identity",
          "lifecycle",
          "version",
          "release",
          "policy",
          "approval",
          "configuration",
          "quota",
          "idempotency",
          "outbox",
          "audit_reference",
          "semantic_knowledge",
          "semantic_claim",
          "semantic_relationship",
          "semantic_evidence",
          "work_lease",
          "work_fence",
          "work_retry",
          "artifact_payload",
          "vector_payload",
          "secret_material"
        ]
      },
      {
        "id": "secret_provider",
        "kind": "secret_token_provider",
        "authority": "secret_material",
        "authoritative_classes": ["secret_material"],
        "prohibited_classes": [
          "identity",
          "lifecycle",
          "version",
          "release",
          "policy",
          "approval",
          "configuration",
          "quota",
          "idempotency",
          "outbox",
          "audit_reference",
          "semantic_knowledge",
          "semantic_claim",
          "semantic_relationship",
