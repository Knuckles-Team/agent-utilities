          "version",
          "release",
          "policy",
          "approval",
          "configuration",
          "quota",
          "idempotency",
          "outbox",
          "audit_reference"
        ],
        "prohibited_classes": [
          "semantic_knowledge",
          "semantic_claim",
          "semantic_relationship",
          "semantic_evidence",
          "work_lease",
          "work_fence",
          "work_retry",
