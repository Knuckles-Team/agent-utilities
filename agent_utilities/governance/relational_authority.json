          "work_lease",
          "work_fence",
          "work_retry",
          "artifact_payload",
          "vector_payload",
          "observability_payload"
        ]
      }
    ],
    "records": [
      {"id": "identity", "store": "postgres_control_plane", "authority_fields": ["tenant_identity", "principal_authorization"]},
      {"id": "registry", "store": "postgres_control_plane", "authority_fields": ["registry_lifecycle", "registry_version"]},
      {"id": "release", "store": "postgres_control_plane", "authority_fields": ["release_activation"]},
      {"id": "governance", "store": "postgres_control_plane", "authority_fields": ["policy_approval", "configuration_reference", "quota_idempotency"]},
      {"id": "projection", "store": "postgres_control_plane", "authority_fields": ["outbox_projection_event", "audit_resolution"]},
      {"id": "work", "store": "native_work_item", "authority_fields": ["work_item_lease", "work_item_fence", "work_item_retry"]},
      {"id": "semantic", "store": "graphos", "authority_fields": ["semantic_claim", "semantic_relationship", "semantic_evidence"]},
      {"id": "artifact", "store": "artifact_store", "authority_fields": ["artifact_payload"]},
      {"id": "vector", "store": "vector_store", "authority_fields": ["vector_payload"]},
      {"id": "observability", "store": "observability_store", "authority_fields": ["observability_payload"]},
      {"id": "secrets", "store": "secret_provider", "authority_fields": ["secret_material"]}
    ],
    "events": [
      {
        "id": "control_plane_mutation",
        "store": "postgres_control_plane",
        "authority_fields": ["tenant_identity", "principal_authorization", "registry_lifecycle", "registry_version", "release_activation", "policy_approval", "configuration_reference", "quota_idempotency", "outbox_projection_event", "audit_resolution"],
        "payload_fields": ["event_id", "tenant_id", "aggregate_id", "aggregate_version", "authority_digest", "safe_projection"]
      },
      {
        "id": "work_item_lease",
        "store": "native_work_item",
        "authority_fields": ["work_item_lease", "work_item_fence", "work_item_retry"],
        "payload_fields": ["event_id", "work_item_id", "lease_owner", "fencing_token", "lease_expires_at", "attempt"]
      },
      {
        "id": "semantic_observation",
        "store": "graphos",
        "authority_fields": ["semantic_claim", "semantic_relationship", "semantic_evidence"],
        "payload_fields": ["event_id", "connection", "physical_graph", "graph_revision", "evidence_digest"]
      },
      {
        "id": "artifact_committed",
        "store": "artifact_store",
        "authority_fields": ["artifact_payload"],
        "payload_fields": ["event_id", "artifact_id", "media_type", "byte_length", "sha256", "object_ref"]
      },
      {
        "id": "vector_indexed",
        "store": "vector_store",
        "authority_fields": ["vector_payload"],
        "payload_fields": ["event_id", "tenant_id", "physical_graph", "model_digest", "dimension", "index_ref"]
      },
      {
        "id": "observability_recorded",
        "store": "observability_store",
        "authority_fields": ["observability_payload"],
        "payload_fields": ["event_id", "trace_id", "span_id", "metric_name", "recorded_at"]
      },
      {
        "id": "secret_reference_rotated",
        "store": "secret_provider",
        "authority_fields": ["secret_material"],
        "payload_fields": ["event_id", "secret_ref", "version", "status", "rotated_at"]
      }
    ]
  },
  "domains": [
    {
      "name": "usage_store",
      "authority": "usage_backend",
      "schema_source": "usage_store",
      "sqlite_limitations": [
        "SQLite is a single-host development/default backend; it is not a cross-host authority or RLS substitute.",
        "SQLite FTS5 is a local search projection and never owns session/message facts."
      ],
      "postgres_rls": "When a tenant is bound, state/usage connection setup must carry app.tenant_id before reads or writes; policy denial is not an empty result.",
      "tables": [
        {"name": "sessions", "authoritative_fields": ["id", "project", "machine", "agent", "first_message", "started_at", "ended_at", "message_count", "user_message_count", "total_output_tokens", "peak_context_tokens", "is_automated", "outcome", "health_grade", "termination_status", "parent_session_id", "relationship_type", "origin", "tenant_id", "correlation_id", "file_path", "file_hash", "file_mtime", "file_inode", "created_at"], "derived_fields": [], "prohibited_dual_write_domains": ["state_store"]},
        {"name": "messages", "authoritative_fields": ["session_id", "ordinal", "role", "content", "thinking_text", "timestamp", "model", "context_tokens", "output_tokens", "has_tool_use", "content_length"], "derived_fields": [], "prohibited_dual_write_domains": ["state_store"]},
        {"name": "tool_calls", "authoritative_fields": ["id", "session_id", "message_ordinal", "tool_name", "category", "tool_use_id", "input_json", "skill_name", "result_content_length", "subagent_session_id", "status", "occurred_at", "origin", "tenant_id", "correlation_id"], "derived_fields": [], "prohibited_dual_write_domains": ["state_store"]},
        {"name": "usage_events", "authoritative_fields": ["id", "session_id", "message_ordinal", "source", "model", "input_tokens", "output_tokens", "cache_creation_input_tokens", "cache_read_input_tokens", "reasoning_tokens", "cost_usd", "cost_status", "cost_source", "occurred_at", "dedup_key", "origin", "tenant_id", "correlation_id"], "derived_fields": [], "prohibited_dual_write_domains": ["state_store"]},
        {"name": "model_pricing", "authoritative_fields": ["model_pattern", "input_per_mtok", "output_per_mtok", "cache_creation_per_mtok", "cache_read_per_mtok", "updated_at"], "derived_fields": [], "prohibited_dual_write_domains": ["state_store"]},
        {"name": "skipped_files", "authoritative_fields": ["path", "mtime", "size"], "derived_fields": [], "prohibited_dual_write_domains": ["state_store"]},
        {"name": "usage_store_metadata", "authoritative_fields": ["key", "value"], "derived_fields": [], "prohibited_dual_write_domains": ["state_store"]}
      ]
    },
    {
      "name": "state_store",
      "authority": "state_backend",
      "schema_source": "state_store",
      "sqlite_limitations": [
        "SQLite state is per-host and advisory locking is a no-op; it cannot coordinate multiple hosts.",
        "Durable goal lifecycle is engine-native WorkItem/Loop state, not a state-store table."
      ],
      "postgres_rls": "Postgres state connections set app.tenant_id before SQL; tenant-bearing tables must remain RLS-protected and must not be read through an unscoped connection.",
      "tables": [
        {"name": "sessions", "authoritative_fields": ["id", "title", "created_at", "updated_at", "model", "mode", "workspace", "turn_count", "status", "background", "needs_input", "last_response_preview", "goal_id", "metadata_json", "tenant_id"], "derived_fields": [], "prohibited_dual_write_domains": ["usage_store"]},
        {"name": "turns", "authoritative_fields": ["id", "session_id", "turn_number", "role", "content", "created_at", "status", "usage_json", "duration_ms"], "derived_fields": [], "prohibited_dual_write_domains": ["usage_store"]},
        {"name": "dispatch_workers", "authoritative_fields": ["worker_id", "host", "capacity", "active_sessions", "queue_backend", "started_at", "last_heartbeat"], "derived_fields": [], "prohibited_dual_write_domains": ["usage_store"]}
      ]
    }
  ],
  "read_models": [
    {
      "name": "usage_summary",
      "owner_domain": "usage_store",
      "source_tables": ["sessions", "usage_events", "tool_calls"],
      "fields": ["session_count", "totals", "cache_hit_rate"],
      "write_forbidden": true
    },
    {
      "name": "fleet_topology",
      "owner_domain": "state_store",
      "source_tables": ["sessions", "dispatch_workers"],
      "fields": ["sessions", "workers", "domains", "total"],
      "write_forbidden": true
    }
  ]
}
