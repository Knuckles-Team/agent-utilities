        "kind": "epistemic_graph_native_work_item",
        "authority": "leases_and_fences",
        "authoritative_classes": ["work_lease", "work_fence", "work_retry"],
        "prohibited_classes": [
          "identity",
          "lifecycle",
          "version",
          "release",
          "policy",
          "approval",
          "configuration",
          "quota",
