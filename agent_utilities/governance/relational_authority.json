          "vector_payload",
          "observability_payload",
          "secret_material"
        ]
      },
      {
        "id": "graphos",
        "kind": "epistemic_graph",
        "authority": "semantic_knowledge",
        "authoritative_classes": [
          "semantic_knowledge",
          "semantic_claim",
          "semantic_relationship",
          "semantic_evidence"
        ],
        "prohibited_classes": [
