          "outbox",
          "audit_reference",
          "semantic_knowledge",
          "semantic_claim",
          "semantic_relationship",
          "semantic_evidence",
          "artifact_payload",
          "vector_payload",
          "observability_payload",
          "secret_material"
        ]
      },
      {
        "id": "artifact_store",
        "kind": "object_artifact_store",
        "authority": "artifact_payload",
        "authoritative_classes": ["artifact_payload"],
        "prohibited_classes": [
          "identity",
          "lifecycle",
          "version",
          "release",
          "policy",
          "approval",
          "configuration",
          "quota",
          "idempotency",
          "outbox",
