{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphos.invalid/schemas/release-assembly-v1.json",
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[a-f0-9]{64}$"},
    "reference": {"type": "string", "pattern": "^(?=.{1,256}$)[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?:/[A-Za-z0-9][A-Za-z0-9._-]{0,127}){0,15}$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "sbom", "provenance", "signatureBundle"],
      "properties": {
        "source": {"$ref": "#/$defs/reference"},
        "sbom": {"$ref": "#/$defs/reference"},
        "provenance": {"$ref": "#/$defs/reference"},
        "signatureBundle": {"$ref": "#/$defs/reference"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "kind", "artifact", "digest", "evidence", "signatureVerifierEnv", "capabilities"],
      "properties": {
        "version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))*$"},
        "kind": {"enum": ["oci", "catalog"]},
        "artifact": {"type": "string", "pattern": "^(?:oci|catalog):[a-z0-9][a-z0-9.-]{1,127}@sha256:(?!0{64}$)[a-f0-9]{64}$"},
        "digest": {"$ref": "#/$defs/digest"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "signatureVerifierEnv": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,127}$"}},
        "entryCount": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "oci"}}, "required": ["kind"]},
          "then": {"properties": {"artifact": {"pattern": "^oci:"}}},
          "else": {"properties": {"artifact": {"pattern": "^catalog:"}}}
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "releaseId", "sourceFreezeEvidence", "configuration", "migrationPlan", "certifications", "components"],
  "properties": {
    "apiVersion": {"const": "graphos.io/v1"},
    "kind": {"const": "ReleaseAssembly"},
    "releaseId": {"type": "string", "pattern": "^release-[a-z0-9][a-z0-9.-]{2,63}$"},
    "sourceFreezeEvidence": {"$ref": "#/$defs/reference"},
    "configuration": {"$ref": "#/$defs/reference"},
    "migrationPlan": {"$ref": "#/$defs/reference"},
    "certifications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connectorLiveCertificationLedger", "prebundledSkillValidationMatrix", "skillValidationDeployment", "skillValidationLifecycleEvidence", "exactArtifactClosureEvidence", "ociVulnerabilityScanEvidence"],
      "properties": {
        "connectorLiveCertificationLedger": {"$ref": "#/$defs/reference"},
        "prebundledSkillValidationMatrix": {"$ref": "#/$defs/reference"},
        "skillValidationDeployment": {"$ref": "#/$defs/reference"},
        "skillValidationLifecycleEvidence": {"$ref": "#/$defs/reference"},
        "exactArtifactClosureEvidence": {"$ref": "#/$defs/reference"},
        "ociVulnerabilityScanEvidence": {"$ref": "#/$defs/reference"}
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epistemic-operations-protocol", "epistemic-graph", "agent-utilities", "langfuse-agent", "connector-bundles", "prebundled-skills", "ontology-lock", "index-migrations"],
      "properties": {
        "epistemic-operations-protocol": {"$ref": "#/$defs/component"},
        "epistemic-graph": {"$ref": "#/$defs/component"},
        "agent-utilities": {"$ref": "#/$defs/component"},
        "langfuse-agent": {"$ref": "#/$defs/component"},
        "connector-bundles": {"allOf": [{"$ref": "#/$defs/component"}, {"required": ["entryCount"]}]},
        "prebundled-skills": {"allOf": [{"$ref": "#/$defs/component"}, {"required": ["entryCount"]}]},
        "ontology-lock": {"$ref": "#/$defs/component"},
        "index-migrations": {"$ref": "#/$defs/component"}
      }
    }
  }
}
