{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphos.invalid/schemas/release-migration-plan-v1.json",
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[a-f0-9]{64}$"},
    "requirement": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,127}$"}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "releaseId", "compatibilityMatrixDigest", "indexMigrationCatalogDigest", "indexMigrationCount", "migrationMode", "execution"],
  "properties": {
    "apiVersion": {"const": "graphos.io/v1"},
    "kind": {"const": "ReleaseMigrationPlan"},
    "releaseId": {"type": "string", "pattern": "^release-[a-z0-9][a-z0-9.-]{2,63}$"},
    "compatibilityMatrixDigest": {"$ref": "#/$defs/digest"},
    "indexMigrationCatalogDigest": {"$ref": "#/$defs/digest"},
    "indexMigrationCount": {"type": "integer", "minimum": 1},
    "migrationMode": {"const": "one-time-persisted-state"},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["writeFenceRequired", "signedSnapshotRequired", "verifiedMigrationRequired", "idempotentResumeRequired", "rollbackRequires"],
      "properties": {
        "writeFenceRequired": {"const": true},
        "signedSnapshotRequired": {"const": true},
        "verifiedMigrationRequired": {"const": true},
        "idempotentResumeRequired": {"const": true},
        "rollbackRequires": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/requirement"}
        }
      }
    }
  }
}
