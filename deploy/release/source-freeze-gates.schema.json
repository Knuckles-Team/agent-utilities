{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-utilities:source-freeze-gates:1",
  "title": "Agent Utilities source-freeze gate manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "repositories", "commands", "gates"],
  "properties": {
    "schema": {"const": "source-freeze-gates/1"},
    "repositories": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind"],
          "properties": {
            "id": {"const": "agent-utilities"},
            "kind": {"const": "repository"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind"],
          "properties": {
            "id": {"const": "epistemic-graph"},
            "kind": {"const": "repository"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind"],
          "properties": {
            "id": {"const": "langfuse-agent"},
            "kind": {"const": "repository"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind"],
          "properties": {
            "id": {"const": "provider-fleet"},
            "kind": {"const": "fleet"}
          }
        }
      ],
      "items": false
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/command"}
    },
    "gates": {
      "type": "array",
      "minItems": 39,
      "maxItems": 39,
      "items": {"$ref": "#/$defs/gate"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "gateId": {
      "type": "string",
      "pattern": "^G-(?:0[1-9]|[12][0-9]|3[0-9])$"
    },
    "repositoryId": {
      "enum": [
        "agent-utilities",
        "epistemic-graph",
        "langfuse-agent",
        "provider-fleet"
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "argv", "timeout_seconds", "covers"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "repository": {"$ref": "#/$defs/repositoryId"},
        "argv": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 600
        },
        "covers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/gateId"}
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "evidence_classes", "scope", "command_ids", "rationale"],
      "properties": {
        "id": {"$ref": "#/$defs/gateId"},
        "evidence_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["local-source", "exact-artifact", "external", "terminal"]
          }
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repositoryId"}
        },
        "command_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    }
  }
}
