{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphos.invalid/schemas/prebundled-skill-validation-evidence-v2.json",
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[a-f0-9]{64}$"},
    "result": {"enum": ["pass", "fail"]},
    "check": {"enum": ["pass", "fail", "not-applicable"]},
    "opaqueRef": {"type": ["string", "null"], "pattern": "^pref_[a-z_]+_[a-f0-9]{64}$"},
    "traceName": {"type": "string", "pattern": "^graph_run:pref_run_[a-f0-9]{64}$"},
    "architectureOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "operation", "status", "requestDigest", "responseDigest", "matchedRecordCount"],
      "properties": {
        "phase": {"enum": ["registry_lookup", "discovery", "caller_impact"]},
        "operation": {"enum": ["graph_query", "graph_search", "graph_code"]},
        "status": {"enum": ["verified", "advisory", "grounded", "observed", "timeout", "error"]},
        "requestDigest": {"$ref": "#/$defs/digest"},
        "responseDigest": {"$ref": "#/$defs/digest"},
        "matchedRecordCount": {"type": "integer", "minimum": 0, "maximum": 32}
      }
    },
    "architectureScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario", "outcome"],
      "properties": {
        "scenario": {"enum": ["registry_unavailable", "registry_outdated", "owner_manifest_identity_disagreement", "regeneration_reingestion", "finite_exception_metadata", "caller_deletion_evidence", "concept_discovery_only", "plans_cutover", "layer_boundary_vs_component", "parent_layer_no_signature_match", "component_owned_roots", "worker_lane_shared_file_exception"]},
        "outcome": {"enum": ["available", "current", "matched", "not_required", "verified", "discovery_only", "authoritative", "implementation_component", "fail_closed", "rejected", "rf021_handoff"]}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "signature", "subjectDigest"],
      "properties": {
        "algorithm": {"enum": ["ed25519", "ecdsa-p256-sha256", "rsa-pss-sha256"]},
        "keyId": {"type": "string", "pattern": "^key:[a-f0-9]{64}$"},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43,4096}$"},
        "subjectDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "caseDigest", "skill", "mode", "modelClass", "status", "checks", "skillRef", "skillBodyRef", "runRef", "traceRef", "langfuse", "parentKnowledgeGraph", "architecture", "errorCodes"],
      "properties": {
        "caseId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "caseDigest": {"$ref": "#/$defs/digest"},
        "skill": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "mode": {"enum": ["direct", "delegated"]},
        "modelClass": {"enum": ["economy", "standard"]},
        "status": {"$ref": "#/$defs/result"},
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["structural", "modelSelection", "skillBinding", "semantic", "delegation", "trace", "parentKnowledgeGraph"],
          "properties": {
            "structural": {"$ref": "#/$defs/check"},
            "modelSelection": {"$ref": "#/$defs/check"},
            "skillBinding": {"$ref": "#/$defs/check"},
            "semantic": {"$ref": "#/$defs/check"},
            "delegation": {"$ref": "#/$defs/check"},
            "trace": {"$ref": "#/$defs/check"},
            "parentKnowledgeGraph": {"$ref": "#/$defs/check"}
          }
        },
        "skillRef": {"$ref": "#/$defs/opaqueRef"},
        "skillBodyRef": {"$ref": "#/$defs/opaqueRef"},
        "runRef": {"$ref": "#/$defs/opaqueRef"},
        "traceRef": {"$ref": "#/$defs/opaqueRef"},
        "langfuse": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lookupMethod", "metadataOnly", "traceName", "matchCount", "linkage"],
          "properties": {
            "lookupMethod": {"const": "exact-name"},
            "metadataOnly": {"const": true},
            "traceName": {"anyOf": [{"$ref": "#/$defs/traceName"}, {"type": "null"}]},
            "matchCount": {"type": "integer", "minimum": 0, "maximum": 1},
            "linkage": {"enum": ["run-evidence", "none"]}
          }
        },
        "parentKnowledgeGraph": {
          "type": "object",
          "additionalProperties": false,
          "required": ["readbackMethod", "matchCount"],
          "properties": {
            "readbackMethod": {"const": "exact-trace-name"},
            "matchCount": {"type": "integer", "minimum": 0, "maximum": 1}
          }
        },
        "architecture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidateRef", "operations", "scenarios"],
          "properties": {
            "candidateRef": {"$ref": "#/$defs/opaqueRef"},
            "operations": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/architectureOperation"}},
            "scenarios": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/architectureScenario"}}
          }
        },
        "errorCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,95}$"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "direct"}}, "required": ["mode"]},
          "then": {"properties": {"checks": {"properties": {"delegation": {"const": "not-applicable"}}}}},
          "else": {"properties": {"checks": {"properties": {"delegation": {"enum": ["pass", "fail"]}}}}}
        },
        {
          "if": {"properties": {"status": {"const": "pass"}}, "required": ["status"]},
          "then": {
            "properties": {
              "checks": {
                "properties": {
                  "structural": {"const": "pass"},
                  "modelSelection": {"const": "pass"},
                  "skillBinding": {"const": "pass"},
                  "semantic": {"const": "pass"},
                  "trace": {"const": "pass"},
                  "parentKnowledgeGraph": {"const": "pass"}
                }
              },
              "skillRef": {"type": "string"},
              "skillBodyRef": {"type": "string"},
              "runRef": {"type": "string"},
              "traceRef": {"type": "string"},
              "langfuse": {"properties": {"traceName": {"$ref": "#/$defs/traceName"}, "matchCount": {"const": 1}, "linkage": {"const": "run-evidence"}}},
              "parentKnowledgeGraph": {"properties": {"matchCount": {"const": 1}}},
              "errorCodes": {"maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"skill": {"const": "agent-utilities-development"}}, "required": ["skill"]},
          "then": {
            "properties": {
              "architecture": {
                "properties": {
                  "candidateRef": {"type": "string"},
                  "operations": {
                    "minItems": 3,
                    "maxItems": 3,
                    "prefixItems": [
                      {"allOf": [{"$ref": "#/$defs/architectureOperation"}, {"properties": {"phase": {"const": "registry_lookup"}, "operation": {"const": "graph_query"}}}]},
                      {"allOf": [{"$ref": "#/$defs/architectureOperation"}, {"properties": {"phase": {"const": "discovery"}, "operation": {"const": "graph_search"}}}]},
                      {"allOf": [{"$ref": "#/$defs/architectureOperation"}, {"properties": {"phase": {"const": "caller_impact"}, "operation": {"const": "graph_code"}}}]}
                    ],
                    "items": false
                  },
                  "scenarios": {
                    "minItems": 12,
                    "maxItems": 12,
                    "prefixItems": [
                      {"properties": {"scenario": {"const": "registry_unavailable"}}},
                      {"properties": {"scenario": {"const": "registry_outdated"}}},
                      {"properties": {"scenario": {"const": "owner_manifest_identity_disagreement"}}},
                      {"properties": {"scenario": {"const": "regeneration_reingestion"}}},
                      {"properties": {"scenario": {"const": "finite_exception_metadata"}}},
                      {"properties": {"scenario": {"const": "caller_deletion_evidence"}}},
                      {"properties": {"scenario": {"const": "concept_discovery_only"}}},
                      {"properties": {"scenario": {"const": "plans_cutover"}}},
                      {"properties": {"scenario": {"const": "layer_boundary_vs_component"}}},
                      {"properties": {"scenario": {"const": "parent_layer_no_signature_match"}}},
                      {"properties": {"scenario": {"const": "component_owned_roots"}}},
                      {"properties": {"scenario": {"const": "worker_lane_shared_file_exception"}}}
                    ],
                    "items": false
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "architecture": {
                "properties": {
                  "candidateRef": {"type": "null"},
                  "operations": {"maxItems": 0},
                  "scenarios": {"maxItems": 0}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "skill": {"const": "agent-utilities-development"},
              "status": {"const": "pass"}
            },
            "required": ["skill", "status"]
          },
          "then": {
            "properties": {
              "architecture": {
                "properties": {
                  "operations": {
                    "prefixItems": [
                      {"properties": {"status": {"const": "verified"}, "matchedRecordCount": {"const": 1}}},
                      {"properties": {"status": {"const": "advisory"}, "matchedRecordCount": {"const": 1}}},
                      {"properties": {"status": {"const": "grounded"}, "matchedRecordCount": {"minimum": 1, "maximum": 32}}}
                    ]
                  },
                  "scenarios": {
                    "prefixItems": [
                      {"properties": {"outcome": {"const": "available"}}},
                      {"properties": {"outcome": {"const": "current"}}},
                      {"properties": {"outcome": {"const": "matched"}}},
                      {"properties": {"outcome": {"const": "not_required"}}},
                      {"properties": {"outcome": {"const": "verified"}}},
                      {"properties": {"outcome": {"const": "verified"}}},
                      {"properties": {"outcome": {"const": "discovery_only"}}},
                      {"properties": {"outcome": {"const": "authoritative"}}},
                      {"properties": {"outcome": {"const": "implementation_component"}}},
                      {"properties": {"outcome": {"const": "verified"}}},
                      {"properties": {"outcome": {"const": "verified"}}},
                      {"properties": {"outcome": {"const": "verified"}}}
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "evidenceVersion", "generatedAt", "release", "runtime", "catalog", "cases", "result", "privacy", "signature"],
  "properties": {
    "apiVersion": {"const": "graphos.io/v2"},
    "kind": {"const": "PrebundledSkillValidationEvidence"},
    "evidenceVersion": {"const": 2},
    "generatedAt": {"type": "string", "format": "date-time"},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "specificationDigest", "promotionEvidenceDigest", "graphOsDigest", "engineDigest"],
      "properties": {
        "id": {"type": "string", "pattern": "^release-[a-z0-9][a-z0-9.-]{2,63}$"},
        "specificationDigest": {"$ref": "#/$defs/digest"},
        "promotionEvidenceDigest": {"$ref": "#/$defs/digest"},
        "graphOsDigest": {"$ref": "#/$defs/digest"},
        "engineDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configurationDigest", "profileDigest", "modelRegistryDigest", "sequential", "metadataOnlyObservability"],
      "properties": {
        "configurationDigest": {"$ref": "#/$defs/digest"},
        "profileDigest": {"$ref": "#/$defs/digest"},
        "modelRegistryDigest": {"$ref": "#/$defs/digest"},
        "sequential": {"const": true},
        "metadataOnlyObservability": {"const": true}
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skillCount", "skillCatalogDigest", "testCaseCount", "testCatalogDigest", "caseCatalogDigest"],
      "properties": {
        "skillCount": {"const": 13},
        "skillCatalogDigest": {"$ref": "#/$defs/digest"},
        "testCaseCount": {"const": 26},
        "testCatalogDigest": {"$ref": "#/$defs/digest"},
        "caseCatalogDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"caseId": {"const": "contribution-delegated"}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"caseId": {"const": "contribution-direct"}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"caseId": {"const": "deployment-delegated"}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"caseId": {"const": "deployment-direct"}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"caseId": {"const": "development-delegated"}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"caseId": {"const": "development-direct"}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"caseId": {"const": "engine-delegated"}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"caseId": {"const": "engine-direct"}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"caseId": {"const": "evolution-delegated"}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"caseId": {"const": "evolution-direct"}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"caseId": {"const": "ingestion-delegated"}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"caseId": {"const": "ingestion-direct"}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"caseId": {"const": "modeling-delegated"}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"caseId": {"const": "modeling-direct"}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"caseId": {"const": "orchestration-delegated"}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"caseId": {"const": "orchestration-direct"}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"caseId": {"const": "query-delegated"}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"caseId": {"const": "query-direct"}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"caseId": {"const": "research-delegated"}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"caseId": {"const": "research-direct"}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"caseId": {"const": "runtime-delegated"}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"caseId": {"const": "runtime-direct"}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"caseId": {"const": "self-evolution-delegated"}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"caseId": {"const": "self-evolution-direct"}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"caseId": {"const": "source-integration-delegated"}}}]},
        {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"caseId": {"const": "source-integration-direct"}}}]}
      ],
      "items": false
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "passedCases", "totalCases", "fullyPassedSkills", "totalSkills"],
      "properties": {
        "status": {"$ref": "#/$defs/result"},
        "passedCases": {"type": "integer", "minimum": 0, "maximum": 26},
        "totalCases": {"const": 26},
        "fullyPassedSkills": {"type": "integer", "minimum": 0, "maximum": 13},
        "totalSkills": {"const": 13}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containsPrompts", "containsModelOutput", "containsEndpoints", "containsCredentials", "containsIdentities", "containsFilesystemLocations", "containsRawTraceIdentifiers"],
      "properties": {
        "containsPrompts": {"const": false},
        "containsModelOutput": {"const": false},
        "containsEndpoints": {"const": false},
        "containsCredentials": {"const": false},
        "containsIdentities": {"const": false},
        "containsFilesystemLocations": {"const": false},
        "containsRawTraceIdentifiers": {"const": false}
      }
    },
    "signature": {"$ref": "#/$defs/signature"}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"properties": {"status": {"const": "pass"}}}}, "required": ["result"]},
      "then": {
        "properties": {
          "result": {"properties": {"passedCases": {"const": 26}, "fullyPassedSkills": {"const": 13}}},
          "cases": {"not": {"contains": {"properties": {"status": {"const": "fail"}}, "required": ["status"]}}}
        }
      }
    }
  ]
}
