{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphos.invalid/schemas/component-source-evidence-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "component", "version", "artifactFormat", "artifactDigest", "artifactInputDigest", "sourceSnapshotDigest", "sourceEvidenceDigest"],
  "properties": {
    "apiVersion": {"const": "graphos.io/v1"},
    "kind": {"const": "ComponentSourceEvidence"},
    "component": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,127}$"},
    "version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))*$"},
    "artifactFormat": {"enum": ["oci-layout-archive", "opaque-catalog"]},
    "artifactDigest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[a-f0-9]{64}$"},
    "artifactInputDigest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[a-f0-9]{64}$"},
    "sourceSnapshotDigest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[a-f0-9]{64}$"},
    "sourceEvidenceDigest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[a-f0-9]{64}$"}
  }
}
