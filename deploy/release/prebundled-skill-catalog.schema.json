{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphos.invalid/schemas/prebundled-skill-catalog-v1.json",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[a-f0-9]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "digest"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
        },
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "treeDigest", "files"],
      "properties": {
        "skill": {"type": "string"},
        "treeDigest": {"$ref": "#/$defs/digest"},
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/file"}
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "catalogVersion",
    "membershipDigest",
    "entryCount",
    "entries"
  ],
  "properties": {
    "apiVersion": {"const": "graphos.io/v1"},
    "kind": {"const": "PrebundledSkillCatalog"},
    "catalogVersion": {"const": 1},
    "membershipDigest": {"$ref": "#/$defs/digest"},
    "entryCount": {"const": 4},
    "entries": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/entry"}, {"properties": {"skill": {"const": "agent-utilities-deployment"}}}]},
        {"allOf": [{"$ref": "#/$defs/entry"}, {"properties": {"skill": {"const": "agent-utilities-development"}}}]},
        {"allOf": [{"$ref": "#/$defs/entry"}, {"properties": {"skill": {"const": "agent-utilities-evolution"}}}]},
        {"allOf": [{"$ref": "#/$defs/entry"}, {"properties": {"skill": {"const": "agent-utilities-self-evolution"}}}]}
      ],
      "items": false
    }
  }
}
