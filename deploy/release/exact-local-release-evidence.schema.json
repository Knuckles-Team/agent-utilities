{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphos.invalid/schemas/exact-local-release-evidence-v2.json",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "rawDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?:[1-9][0-9]*!)?(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))*(?:(?:a|b|rc)(?:0|[1-9][0-9]*))?(?:\\.post(?:0|[1-9][0-9]*))?(?:\\.dev(?:0|[1-9][0-9]*))?(?:\\+(?:0|[1-9][0-9]*|[a-z0-9]*[a-z][a-z0-9]*)(?:\\.(?:0|[1-9][0-9]*|[a-z0-9]*[a-z][a-z0-9]*))*)?$"
    },
    "packageEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "artifactDigest"],
      "properties": {
        "version": {"$ref": "#/$defs/version"},
        "artifactDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "commandEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "exitCode", "outputDigest"],
      "properties": {
        "status": {"enum": ["passed", "failed"]},
        "exitCode": {"type": "integer", "minimum": -255, "maximum": 255},
        "outputDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "passedCommandEvidence": {
      "allOf": [
        {"$ref": "#/$defs/commandEvidence"},
        {
          "properties": {
            "status": {"const": "passed"},
            "exitCode": {"const": 0}
          }
        }
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "signature", "subjectDigest"],
      "properties": {
        "algorithm": {
          "enum": ["ed25519", "ecdsa-p256-sha256", "rsa-pss-sha256"]
        },
        "keyId": {"type": "string", "pattern": "^key:[a-f0-9]{64}$"},
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43,4096}$"
        },
        "subjectDigest": {"$ref": "#/$defs/digest"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "releaseId",
    "status",
    "specDigest",
    "requirementsDigest",
    "packages",
    "nativeArtifacts",
    "toolchain",
    "certificationArtifacts",
    "closure",
    "processGate",
    "activation",
    "commands",
    "errorCode",
    "privacySafe",
    "signature"
  ],
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "promoted"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "closure": {
            "properties": {
              "recordVerified": {"const": true},
              "distributionCount": {"type": "integer", "minimum": 1},
              "directUrlRecordCount": {"const": 0},
              "symlinkCount": {"const": 0},
              "specialFileCount": {"const": 0},
              "nativeArtifactCount": {"const": 2},
              "dependencyEdgeCount": {"type": "integer", "minimum": 1},
              "releaseTreeEntryCount": {"type": "integer", "minimum": 1},
              "immutableAfterProof": {"const": true}
            }
          },
          "processGate": {
            "properties": {
              "beforePromotion": {"const": 0},
              "afterVerification": {"const": 0}
            }
          },
          "commands": {
            "required": ["venv", "install", "canary", "doctor"],
            "properties": {
              "venv": {"$ref": "#/$defs/passedCommandEvidence"},
              "install": {"$ref": "#/$defs/passedCommandEvidence"},
              "canary": {"$ref": "#/$defs/passedCommandEvidence"},
              "doctor": {"$ref": "#/$defs/passedCommandEvidence"}
            }
          },
          "activation": {
            "properties": {"rollback": {"const": "not-required"}}
          },
          "certificationArtifacts": {"type": "object"},
          "errorCode": {"const": null}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["rejected", "rolled-back", "rollback-failed"]
          }
        },
        "required": ["status"]
      },
      "then": {"properties": {"errorCode": {"type": "string"}}}
    },
    {
      "if": {
        "properties": {"status": {"const": "rejected"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "activation": {
            "properties": {"rollback": {"const": "not-required"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "rolled-back"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "activation": {
            "properties": {"rollback": {"const": "completed"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "rollback-failed"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "activation": {
            "properties": {"rollback": {"const": "failed"}}
          }
        }
      }
    }
  ],
  "properties": {
    "apiVersion": {"const": "graphos.io/v2"},
    "kind": {"const": "ExactLocalReleaseEvidence"},
    "releaseId": {
      "type": "string",
      "pattern": "^release-[a-z0-9][a-z0-9.-]{2,63}$"
    },
    "status": {
      "enum": ["promoted", "rejected", "rolled-back", "rollback-failed"]
    },
    "specDigest": {"$ref": "#/$defs/digest"},
    "requirementsDigest": {"$ref": "#/$defs/digest"},
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent-utilities", "epistemic-graph", "langfuse-agent"],
      "properties": {
        "agent-utilities": {"$ref": "#/$defs/packageEvidence"},
        "epistemic-graph": {"$ref": "#/$defs/packageEvidence"},
        "langfuse-agent": {"$ref": "#/$defs/packageEvidence"}
      }
    },
    "nativeArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epistemic-graph-server", "epistemic-graph-numeric"],
      "properties": {
        "epistemic-graph-server": {"$ref": "#/$defs/digest"},
        "epistemic-graph-numeric": {"$ref": "#/$defs/digest"}
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "uv"],
      "properties": {
        "python": {"$ref": "#/$defs/packageEvidence"},
        "uv": {"$ref": "#/$defs/packageEvidence"}
      }
    },
    "certificationArtifacts": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agentUtilitiesSha256",
            "agentUtilitiesFileCount",
            "distributionClosureSha256",
            "releasePythonSha256",
            "graphosSha256",
            "engineSha256"
          ],
          "properties": {
            "agentUtilitiesSha256": {"$ref": "#/$defs/rawDigest"},
            "agentUtilitiesFileCount": {"type": "integer", "minimum": 10},
            "distributionClosureSha256": {"$ref": "#/$defs/rawDigest"},
            "releasePythonSha256": {"$ref": "#/$defs/rawDigest"},
            "graphosSha256": {"$ref": "#/$defs/rawDigest"},
            "engineSha256": {"$ref": "#/$defs/rawDigest"}
          }
        }
      ]
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distributionCount",
        "recordVerified",
        "directUrlRecordCount",
        "symlinkCount",
        "specialFileCount",
        "nativeArtifactCount",
        "dependencyEdgeCount",
        "releaseTreeEntryCount",
        "immutableAfterProof"
      ],
      "properties": {
        "distributionCount": {"type": "integer", "minimum": 0},
        "recordVerified": {"type": "boolean"},
        "directUrlRecordCount": {"type": "integer", "minimum": 0},
        "symlinkCount": {"type": "integer", "minimum": 0},
        "specialFileCount": {"type": "integer", "minimum": 0},
        "nativeArtifactCount": {"type": "integer", "minimum": 0},
        "dependencyEdgeCount": {"type": "integer", "minimum": 0},
        "releaseTreeEntryCount": {"type": "integer", "minimum": 0},
        "immutableAfterProof": {"type": "boolean"}
      }
    },
    "processGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beforePromotion", "afterVerification"],
      "properties": {
        "beforePromotion": {"type": ["integer", "null"], "minimum": 0},
        "afterVerification": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "hadPreviousRelease", "rollback"],
      "properties": {
        "method": {"const": "atomic-symlink-replace"},
        "hadPreviousRelease": {"type": "boolean"},
        "rollback": {"enum": ["not-required", "completed", "failed"]}
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "venv": {"$ref": "#/$defs/commandEvidence"},
        "install": {"$ref": "#/$defs/commandEvidence"},
        "canary": {"$ref": "#/$defs/commandEvidence"},
        "doctor": {"$ref": "#/$defs/commandEvidence"}
      }
    },
    "errorCode": {
      "type": ["string", "null"],
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]{0,127}$"
    },
    "privacySafe": {"const": true},
    "signature": {"$ref": "#/$defs/signature"}
  }
}
