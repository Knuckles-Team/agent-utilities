{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphos.invalid/schemas/index-migration-catalog-v1.json",
  "$defs": {
    "labels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"}
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "catalogVersion", "migrationMode", "entryCount", "entries"],
  "properties": {
    "apiVersion": {"const": "graphos.io/v1"},
    "kind": {"const": "IndexMigrationCatalog"},
    "catalogVersion": {"const": 1},
    "migrationMode": {"const": "one-time-persisted-state"},
    "entryCount": {"type": "integer", "minimum": 1},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["migrationId", "version", "mode", "executor", "fromState", "toState", "preconditions", "postconditions", "rollback"],
        "properties": {
          "migrationId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
          "version": {"type": "string", "pattern": "^[1-9][0-9]*$"},
          "mode": {"const": "one-time-persisted-state"},
          "executor": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
          "fromState": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
          "toState": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
          "preconditions": {"$ref": "#/$defs/labels"},
          "postconditions": {"$ref": "#/$defs/labels"},
          "rollback": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"}
        }
      }
    }
  }
}
