{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphos.invalid/schemas/exact-local-release-spec-v2.json",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?:[1-9][0-9]*!)?(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))*(?:(?:a|b|rc)(?:0|[1-9][0-9]*))?(?:\\.post(?:0|[1-9][0-9]*))?(?:\\.dev(?:0|[1-9][0-9]*))?(?:\\+(?:0|[1-9][0-9]*|[a-z0-9]*[a-z][a-z0-9]*)(?:\\.(?:0|[1-9][0-9]*|[a-z0-9]*[a-z][a-z0-9]*))*)?$"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "wheel", "sha256"],
      "properties": {
        "version": {"$ref": "#/$defs/version"},
        "wheel": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,254}\\.whl$"
        },
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {"$ref": "#/$defs/version"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryPoint", "arguments", "timeoutSeconds"],
      "properties": {
        "entryPoint": {"type": "string"},
        "arguments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"type": "string", "minLength": 1, "maxLength": 64}
        },
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 300}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "releaseId",
    "requirements",
    "packages",
    "nativeArtifacts",
    "toolchain",
    "commands"
  ],
  "properties": {
    "apiVersion": {"const": "graphos.io/v2"},
    "kind": {"const": "ExactLocalRelease"},
    "releaseId": {
      "type": "string",
      "pattern": "^release-[a-z0-9][a-z0-9.-]{2,63}$"
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,254}\\.txt$"
        },
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent-utilities", "epistemic-graph", "langfuse-agent"],
      "properties": {
        "agent-utilities": {"$ref": "#/$defs/package"},
        "epistemic-graph": {"$ref": "#/$defs/package"},
        "langfuse-agent": {"$ref": "#/$defs/package"}
      }
    },
    "nativeArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epistemic-graph-server", "epistemic-graph-numeric"],
      "properties": {
        "epistemic-graph-server": {"$ref": "#/$defs/digest"},
        "epistemic-graph-numeric": {"$ref": "#/$defs/digest"}
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "uv"],
      "properties": {
        "python": {"$ref": "#/$defs/tool"},
        "uv": {"$ref": "#/$defs/tool"}
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canary", "doctor"],
      "properties": {
        "canary": {
          "allOf": [
            {"$ref": "#/$defs/command"},
            {
              "properties": {
                "entryPoint": {"const": "graph-os-release-canary"},
                "arguments": {"const": ["--json"]}
              }
            }
          ]
        },
        "doctor": {
          "allOf": [
            {"$ref": "#/$defs/command"},
            {
              "properties": {
                "entryPoint": {"const": "agent-utilities-doctor"},
                "arguments": {
                  "const": [
                    "--json",
                    "--live",
                    "--only",
                    "engine_request_context",
                    "engine",
                    "langfuse",
                    "native_optimizer",
                    "skills"
                  ]
                }
              }
            }
          ]
        }
      }
    }
  }
}
