{"id": "MERISTEM-HARNESS-CYCLE-R001", "action": "rewrite", "frozen": [], "retired_reason": "", "new_children": ["MERISTEM-HARNESS-CYCLE-R001.14", "MERISTEM-HARNESS-CYCLE-R001.15"], "new_rows_requested": [{"spec": "MERISTEM-SCM", "title": "Engine decision port for the coding loop"}, {"spec": "ARBORA-OPS", "title": "Bind the engine decision port at host start"}, {"spec": "MERISTEM-HARNESS-CYCLE", "title": "Replay recorded engine answers for consumer run tests."}, {"spec": "MERISTEM-HARNESS-CYCLE", "title": "Run lifecycle hooks called from the run loop."}, {"spec": "ARBORA-OPS", "title": "Step usage events reach the usage ledger"}, {"spec": "ARBORA-HOST", "title": "Host registers the harness cycle providers and drives one tick per completed run"}, {"spec": "ARBORA-HOST", "title": "Attach run receipt nodes to the terminal commit"}, {"spec": "MEDULLA-DECISION-ENGINE", "title": "Harness component and harness adoption revision subjects"}, {"spec": "MEDULLA-DECISION-ENGINE", "title": "Harness evolution knobs"}, {"spec": "MEDULLA-DECISION-ENGINE", "title": "Contrast measured from stored traces, scores and the usage ledger"}, {"spec": "MEDULLA-DECISION-ENGINE", "title": "`DecisionLog` op `HarnessAdoption` stores the adoption, contrast and lesson"}], "cross_edits_requested": [{"row": "MERISTEM-HARNESS-CYCLE-R001.1", "change": "ContrastDelta leaves the model (child .14); CycleOutcome keeps its fields."}, {"row": "MERISTEM-HARNESS-CYCLE-R001.12", "change": "measurement_unavailable now means the port is absent or the engine reports insufficient_evidence."}, {"row": "ARBORA-OPS-R068.4", "change": "harness.evolution.adopt binds to the DecisionLog HarnessAdoption op (NEW:11) and the evaluated revision of RevisionSubject::HarnessAdoption."}, {"row": "MEDULLA-DECISION-ENGINE-R805.7", "change": "Add RevisionSubject::HarnessComponent and HarnessAdoption and ReceiptKind::HarnessContrast (NEW:8)."}, {"row": "MEDULLA-DECISION-ENGINE-R803.2", "change": "Adoption thresholds and candidate bounds come from the harness_evolution knobs (NEW:9); deltas are measured by the engine (NEW:10)."}, {"row": "MEDULLA-DECISION-ENGINE-R803.3", "change": "Replace the dead AU-HARNESS-CYCLE-R001.5 caller with MERISTEM-HARNESS-CYCLE-R001.4 and adoption through the DecisionLog op HarnessAdoption (NEW:11)."}, {"row": "ARBORA-OPS-R852", "change": "harness.promote and harness.rollback accept the subject kinds harness_component and harness_adoption (NEW:8)."}], "decisions": ["The engine, not the harness, measures contrasts: traces, scores and cost are facts that medulla stores.", "A per-task adoption is an evaluated revision. A champion moves only through MEDULLA-DECISION-ENGINE-R805 over accumulated contrasts.", "Lessons are evidence records with a supersession edge and no champion, so they are not a revision subject."], "consumer_notes": []}
