#!/usr/bin/env python3
"""Bootstrap launcher for the sanctioned shared-venv reconciler.

CONCEPT:AU-OS.deployment.workspace-venv-reconciler

``agent-utilities-venv`` is a console script *inside* the virtualenv it
manages, which makes it useless in the one situation you need it most: when
that virtualenv is broken.  This launcher has no dependencies at all — it puts
this checkout on ``sys.path`` and runs the module directly under whatever
interpreter started it.

Install a copy where you want it::

    python3 agent-packages/agent-utilities/scripts/venvctl install-launcher

Then, from anywhere in the workspace::

    venvctl status                     # is the shared venv current?
    venvctl sync                       # make it current, guardrailed
    venvctl upgrade --package fastmcp  # relock forward, verify, auto-roll-back
    venvctl rollback                   # restore the previous uv.lock and re-sync
    venvctl autosync on                # flip live on every local merge to main
"""

from __future__ import annotations

import os
import stat
import sys
from pathlib import Path

_CHECKOUT = Path(__file__).resolve().parents[1]


def _install_launcher(destinations: list[Path]) -> int:
    """Copy this launcher to stable locations that survive a broken venv."""

    source = Path(__file__).resolve()
    body = source.read_text(encoding="utf-8")
    for destination in destinations:
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.write_text(body, encoding="utf-8")
        destination.chmod(destination.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP)
        sys.stdout.write(f"installed launcher: {destination}\n")
    return 0


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if args and args[0] == "install-launcher":
        targets = [Path(p).expanduser() for p in args[1:]]
        if not targets:
            targets = [Path.home() / ".local" / "bin" / "venvctl"]
        return _install_launcher(targets)

    if str(_CHECKOUT) not in sys.path:
        sys.path.insert(0, str(_CHECKOUT))
    try:
        from agent_utilities.deployment.venv_sync import main as venv_main
    except ImportError as exc:
        sys.stderr.write(
            f"error: could not import the reconciler from {_CHECKOUT}: {exc}\n"
            "This launcher must live in an agent-utilities checkout "
            "(scripts/venvctl next to the agent_utilities package).\n"
        )
        return 2
    return venv_main(args)


if __name__ == "__main__":
    os.environ.setdefault("PYTHONUNBUFFERED", "1")
    raise SystemExit(main())
