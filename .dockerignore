# Keep the build context lean. The normal target installs the published package; the
# release target installs one digest-verified staged wheel. Never send VCS metadata or
# local credentials to the build daemon.
.git
.env.*
.venv
*.key
*.pem
*.p12
*.pfx
id_rsa*
id_ed25519*
# Neither target builds from source. The only non-wheel context files a build reads are
# overrides.txt (uv pin override) and docker/requirements-multiplexer.txt (the slim
# mcp leg). Everything below is dev/test/CI scaffolding or caches that bloat the context.
.git/
.github/
.specify/
.acp-sessions/
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# Tests, docs, examples, deploy manifests, dev scripts — not part of the wheel.
tests/
docs/
examples/
deploy/
workspace/
scripts/

# Caches / scratch / local state.
.pytest_tmp/
.hypothesis/
.ruff_cache/
.mypy_cache/
*.egg-info/
*.db
*.db-wal
*.sqlite*
.env
.env.example

# Other Dockerfiles / compose — not needed inside the build context, EXCEPT the
# multiplexer runtime-deps list the slim mcp leg installs.
docker/*
!docker/requirements-multiplexer.txt
mkdocs.yml

# The exact release-wheel input is the only local artifact admitted to the release
# target. Everything else in the staging directory remains outside the build context.
release-wheelhouse/*
!release-wheelhouse/*.whl
!release-wheelhouse/*.txt
