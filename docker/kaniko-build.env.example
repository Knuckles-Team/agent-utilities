# Env vars for rendering the ad hoc `docker/graphos-unified*-kaniko-job.yaml` manifests
# (D-PCC-1). Every one of them takes a real, literal filesystem path as a `hostPath`
# volume and a real node hostname as a `nodeSelector` -- Kubernetes gives kaniko no other
# way to see this repo's build context (no dockerd on the hosts) or the staged eg wheel,
# and `kubectl apply` does no env substitution of its own. So these values cannot be
# tracked as literals (that is exactly the leak D-PCC-1 fixed) and cannot be templated
# away structurally either -- they are rendered with `envsubst` immediately before apply:
#
#   set -a; source docker/kaniko-build.env; set +a
#   envsubst < docker/graphos-unified-kaniko-job.yaml | kubectl apply -f -
#
# Copy this file to `docker/kaniko-build.env` (already gitignored — never commit real
# values) and fill in the real ones for your node. None of the placeholders below are
# functional; they document the SHAPE each variable takes, not a working default.

# The node these builds must run on -- kaniko has no dockerd, so this repo builds on one
# pinned host via nodeSelector. Usually the same node backing the workspace's NFS export.
KANIKO_BUILD_NODE=your-build-node-hostname

# The au checkout kaniko uses as its build context (Dockerfile + source). For the base
# and skill-runtime jobs this is the canonical au checkout; for the fastmcp4/langfuse
# follow-up jobs it is whichever lane worktree carries the change being validated -- see
# each manifest's own header comment for which one it expects.
WORKSPACE_HOSTPATH=/path/to/your/agent-utilities-checkout-or-worktree

# The staged epistemic-graph wheel, mounted at build-artifacts/eg-wheel/ inside the
# workspace context (kaniko takes exactly one --context directory, so this is a
# pod-local mount composition, not a change to either directory on disk).
EG_WHEEL_HOSTPATH=/path/to/your/staged-eg-wheel-directory

# The langfuse-agent sibling repo, mounted at build-artifacts/langfuse-agent-src/ the
# same way. Only used by the langfuse/fastmcp4/skill-runtime job variants.
LANGFUSE_AGENT_HOSTPATH=/path/to/your/langfuse-agent-checkout
