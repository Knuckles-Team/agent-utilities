# ═══════════════════════════════════════════════════════════════════════════════
# agent-utilities — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════════
#
# This file is a non-secret catalog of explicit process-environment keys. Never
# copy or load it as a dotenv file; AgentConfig does not search repositories or
# launch directories for dotenv files.
#
# Persist typed settings in the XDG AgentConfig document. Persist only
# reference fields there; put referenced values in the private XDG runtime-secret
# source or an external secret backend. Literal secrets and header maps are
# process-only and must be injected by the deployment supervisor.
#
# The commented assignments below intentionally contain no credential values.
# List or dictionary process variables use JSON strings.
# ═══════════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────────
#  1. Primary Model Registry (JSON Overrides)
# ───────────────────────────────────────────────────────────────────────────────
# [OPTIONAL] JSON string array of chat models. Overrides config.json registries.
# CHAT_MODELS='[{"id":"chat-model","provider":"openai","base_url":"https://chat-model.example.test/v1","api_key_ref":"env://MODEL_API_KEY_1","headers_ref":"env://MODEL_HEADERS_1","intelligence_level":"normal"}]'

# [OPTIONAL] JSON string array of embedding models. Overrides config.json registries.
# EMBEDDING_MODELS='[{"id":"embedding-model","provider":"openai","base_url":"https://embedding-model.example.test/v1","api_key_ref":"env://MODEL_API_KEY_2","headers_ref":"env://MODEL_HEADERS_2","chunk_size":768}]'


# ───────────────────────────────────────────────────────────────────────────────
#  2. Process-only Provider Overrides
# ───────────────────────────────────────────────────────────────────────────────
# These literal key variables are accepted only from the explicit process
# environment. Durable AgentConfig must use the provider's dedicated *_REF field.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# HUGGING_FACE_API_KEY=
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# [OPTIONAL] Neutral external-provider profiles. Durable values are references;
# resolved endpoints, credentials, selectors, and TLS material remain runtime-only.
# PROVIDER_CONFIGS='{"example-provider":{"enabled":true,"endpoint_ref":"env://EXAMPLE_PROVIDER_ENDPOINT","credential_refs":{"EXAMPLE_PROVIDER_TOKEN":"secret://providers/example/token"},"selector_refs":{},"tls_profile_ref":"secret://tls/example-provider"}}'


# ───────────────────────────────────────────────────────────────────────────────
#  3. Agent Identity & Workspaces
# ───────────────────────────────────────────────────────────────────────────────
# [OPTIONAL] Agent display identity
# DEFAULT_AGENT_NAME=Agent
# AGENT_DESCRIPTION="AI Agent"
# AGENT_SYSTEM_PROMPT=
# DEPLOYMENT_PROFILE=tiny                      # tiny | single-node-prod | enterprise

# [OPTIONAL] System workspace path (where filesystem and repository tools execute)
# WORKSPACE_PATH=./runtime-workspace
# EVOLUTION_STAGING_ROOT=./runtime-evolution-staging  # Explicit private (0700) review-artifact root

# [OPTIONAL] Custom XDG configuration root path
# AGENT_UTILITIES_CONFIG_DIR=                  # Optional XDG root override


# ───────────────────────────────────────────────────────────────────────────────
#  4. Server Network Settings
# ───────────────────────────────────────────────────────────────────────────────
# [OPTIONAL] Core protocol server network settings
# HOST=127.0.0.1
# PORT=9000
# DEBUG=false

# [OPTIONAL] Native epistemic-graph TLS. External engines are selected only by
# GRAPH_SERVICE_ENDPOINTS=tls://... with a named or secret-ref-backed profile.
# ENGINE_TLS_PROFILE=
# ENGINE_TLS_PROFILE_REF=
# ENGINE_TLS_SERVER_NAME=

# [OPTIONAL] Model/embedder transport trust. Prefer named, secret-backed TLS
# profiles for custom CAs and mTLS. Private/loopback provider hosts are denied
# unless their exact hostname is listed; model traffic is DNS-pinned and does
# not inherit ambient proxies.
# MODEL_TLS_PROFILE=
# MODEL_TLS_PROFILE_REF=
# EMBEDDING_TLS_PROFILE=
# EMBEDDING_TLS_PROFILE_REF=
# OAUTH2_TOKEN_TLS_PROFILE=
# OAUTH2_TOKEN_TLS_PROFILE_REF=
# MODEL_HTTP_ALLOWED_PRIVATE_HOSTS=[]

# [OPTIONAL] Sovereign/air-gap deployment gate (CONCEPT:AU-OS.deployment.airgap-mode).
# When true, the canonical outbound HTTP factory (core/http_client.py) and the
# LLM client constructor (core/model_factory.py) refuse any request whose
# target host is not loopback/RFC1918-private/link-local — fail-closed with
# AirgapViolation instead of silently phoning out. Off by default. See
# docs/guides/sovereign-self-hosted.md §4.
# AIRGAP_MODE=false

# [OPTIONAL] Shared outbound-source egress policy. Values are JSON arrays of
# exact hostnames; URLs, wildcards, private IP ranges, and implicit redirects
# are rejected. Private hosts require an explicit exact-host entry. TLS trust
# comes from SOURCE_HTTP_TLS_PROFILE or the global secret-backed TLS profile.
# Each DNS-approved hop is address-pinned while Host/SNI retain the logical
# hostname. Ambient proxies are excluded; use an explicit HTTP/SOCKS profile
# proxy (unsupported pin/SNI combinations fail closed).
# SOURCE_HTTP_ALLOWED_PRIVATE_HOSTS=[]
# SOURCE_HTTP_ALLOWED_REDIRECT_HOSTS=[]
# SOURCE_HTTP_MAX_RESPONSE_BYTES=10485760
# SOURCE_HTTP_MAX_REDIRECTS=3
# SOURCE_HTTP_ALLOW_BROWSER_FETCH=false
# [OPTIONAL] Exact private/loopback model hosts permitted by the pinned LLM
# transport. Keep empty for public HTTPS-only providers; no URLs or wildcards.
# MODEL_HTTP_ALLOWED_PRIVATE_HOSTS=[]

# [OPTIONAL] Mandatory governed model-context sizing/version boundaries.
# Compilation itself cannot be disabled; these values only tune the evidence
# budget and invalidate cache identities when ordering/redaction semantics change.
# MODEL_CONTEXT_TOKEN_BUDGET=2000
# MODEL_CONTEXT_ORDERING_VERSION=context-mmr-v1
# MODEL_CONTEXT_REDACTION_VERSION=permissioning-v1

# [OPTIONAL] UI Toggles
# ENABLE_WEB_UI=false
# ENABLE_TERMINAL_UI=false
# ENABLE_WEB_LOGS=false

# [OPTIONAL] Agent Control Protocol (ACP) parameters
# ENABLE_ACP=false
# ACP_PORT=8001
# ACP_SESSION_ROOT=.acp-sessions


# ───────────────────────────────────────────────────────────────────────────────
#  5. Security & Authentication
# ───────────────────────────────────────────────────────────────────────────────
# [OPTIONAL] API basic authorization and file transfer controls
# MAX_UPLOAD_SIZE=10485760                     # Limit upload size in bytes (10MB default)

# [OPTIONAL] OIDC / JWT Token Verification
# AUTH_JWT_JWKS_URI=https://identity.provider/keys
# AUTH_JWT_ISSUER=https://identity.provider
# AUTH_JWT_AUDIENCE=my-agent-client-id

# [OPTIONAL] OIDC Client Delegation (RFC 8693 Token Exchange)
# OIDC_CONFIG_URL=https://identity.provider/.well-known/openid-configuration
# OIDC_CLIENT_ID=client-id
# OIDC_CLIENT_SECRET_REF=
# ENABLE_DELEGATION=false
# AUDIENCE=https://downstream.api/v1           # Target audience for exchange
# DELEGATED_SCOPES=api                         # Space-separated scopes

# [OPTIONAL] CORS & Host Security
# ALLOWED_ORIGINS=                             # Unset disables cross-origin requests
# CORS_ALLOW_CREDENTIALS=false                 # Requires exact, non-wildcard origins
# ALLOWED_HOSTS=localhost,127.0.0.1,[::1]       # Required for non-loopback listeners


# ───────────────────────────────────────────────────────────────────────────────
#  6. Secrets Storage Backend
# ───────────────────────────────────────────────────────────────────────────────
# [OPTIONAL] Secret backends (encrypted engine store or vault)
# SECRETS_BACKEND=engine
# SECRETS_VAULT_URL=http://127.0.0.1:8200
# SECRETS_VAULT_MOUNT=secret

# [OPTIONAL] Vault / OpenBao Auth & Settings (used with 'vault' backend)
# VAULT_AUTH_METHOD=auto                       # auto | oidc | approle | token | kubernetes
# VAULT_AUTH_MOUNT=jwt                         # Auth mount path
# VAULT_ROLE=default                           # Login role name
# VAULT_PATH_PREFIX=agents/mcp/                # KV v2 path prefix

# [REQUIRED OUTSIDE NON-PRODUCTION TINY MODE] External bootstrap reference for
# the packaged engine data-encryption key. secret:// is intentionally rejected.
# EPISTEMIC_GRAPH_ENCRYPTION_KEY_REF=vault://apps/graph-os/engine-data-key

# [OPTIONAL] Privacy-safe durable identity references. Production templates use
# this neutral reference; the secret controller injects the referenced value.
# PERSISTENCE_IDENTITY_HMAC_KEY_REF=vault://apps/graph-os/identity-hmac-key
# PERSISTENCE_PRIVACY_DENY_TERMS_REF=vault://apps/graph-os/privacy-deny-terms

# [REQUIRED IN PRODUCTION] Metadata-only usage and Langfuse traces.
# USAGE_CONTENT_RETENTION=metadata
# LANGFUSE_CAPTURE_CONTENT=false
# LANGFUSE_MCP_ENABLED=                      # auto-on when both key refs are present
# LANGFUSE_KG_AUTO_INGEST=false              # explicit parent-governed graph-write gate
# KG_FAILURE_EVOLUTION=                     # auto-on when both key refs are present
# KG_OPTIMIZATION_ENABLED=true              # propose-only native optimization sweep

# [OPTIONAL] Raw Memento recovery is OFF by default. It is enabled only when all
# three values are present; raw blocks are then stored as authenticated ciphertext.
# MEMENTO_RAW_RETENTION_ENABLED=false
# MEMENTO_RAW_RETENTION_POLICY=approved-encrypted-v1
# MEMENTO_RAW_ENCRYPTION_KEY_REF=vault://apps/graph-os/memento-raw-key


# ───────────────────────────────────────────────────────────────────────────────
#  7. Graph Orchestration & Persistence
# ───────────────────────────────────────────────────────────────────────────────
# Epistemic-graph is always the operational authority. To add external
# projections for interop/BI/DR, declare targets; fan-out activates automatically.
# GRAPH_MIRROR_TARGETS=age                     # CSV/JSON of mirror connection names (e.g. age,neo4j,falkordb)
# GRAPH_DB_CONNECTION_PROFILE_REF=vault://graph/connections#profile
# Multi-SoR asset mirror — project the KG's :Asset/CI model out to CMDB sinks.
# Empty by default (every sink inert). List a subset of servicenow,erpnext,egeria,twenty.
# Each listed sink still needs its own <SINK>_ENABLE_WRITE for live writes (dry-run-first).
# ASSET_MIRROR_TARGETS=servicenow,egeria       # CSV/JSON of enabled CMDB sinks
# SERVICENOW_ENABLE_WRITE=false                # gate live writes per sink (fail-closed)
# ERPNEXT_ENABLE_WRITE=false
# EGERIA_ENABLE_WRITE=false
# TWENTY_ENABLE_WRITE=false
# [OPTIONAL] Graph Orchestration routing and validations
# ROUTING_STRATEGY=hybrid                      # hybrid | semantic | rule-based
# GRAPH_PERSISTENCE_TYPE=file                  # file | memory
# GRAPH_PERSISTENCE_PATH=~/.local/share/agent-utilities/graph_state
# ENABLE_LLM_VALIDATION=false                  # Validate outputs via additional LLM passes
# GRAPH_ROUTER_TIMEOUT=300.0                   # Router maximum timeout in seconds
# GRAPH_VERIFIER_TIMEOUT=300.0                 # Verifier maximum timeout in seconds
# MIN_CONFIDENCE=0.4                           # Routing decision confidence threshold
# VALIDATION_MODE=false                        # Mock LLM generation for CI/testing
# APPROVAL_TIMEOUT=0.0                         # Seconds to wait for manual human approval (0 = block)


# ───────────────────────────────────────────────────────────────────────────────
#  8. Knowledge Graph Ingestion & Tuning
# ───────────────────────────────────────────────────────────────────────────────
# [OPTIONAL] Graph timeouts and structural constraints
# GRAPH_TIMEOUT=1200000                        # Global network/query timeout in ms
# MAX_RECURSION_DEPTH=2                        # Maximum graph expansion depth
# ROUTING_PERCENTILE=50.0                      # Semantic routing percentile limit
# KG_EMBEDDING_DIM=768                         # Knowledge Graph embedding dimension size

# [OPTIONAL] Knowledge Graph Sync and Concurrency
# ENABLE_KG_EMBEDDINGS=true
# KG_BACKUPS=3                                 # Keep N timestamped SQLite/DuckDB backups
# KG_INGESTION_WORKERS=                        # Max worker threads for codebase ingestion
# KG_LLM_CONCURRENCY=4                         # Max concurrent LLM calls for KG analysis
# KG_ANALYSIS_MAX_DEPTH=2                      # Ingestion graph analyzer recursion depth
# KNOWLEDGE_GRAPH_SYNC_BACKGROUND=true        # Sync knowledge graph in the background
# MODEL_REGISTRY_PATH=                         # Path to models.yaml registry


# ───────────────────────────────────────────────────────────────────────────────
#  9. Observability & Telemetry
# ───────────────────────────────────────────────────────────────────────────────
# [OPTIONAL] OpenTelemetry (OTLP) Exports
# ENABLE_OTEL=false
# TRACE_EXPORT_ENABLED=false
# LANGFUSE_MCP_ENABLED=                       # auto-on with both key refs; false opts out
# OTEL_EXPORTER_OTLP_ENDPOINT=https://telemetry.example.test/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS_REF=env://OTEL_AUTH_HEADERS
# OTEL_EXPORTER_OTLP_PUBLIC_KEY_REF=env://OTEL_PUBLIC_KEY
# OTEL_EXPORTER_OTLP_SECRET_KEY_REF=env://OTEL_SECRET_KEY
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_TLS_PROFILE=runtime-trust
# OTEL_TLS_PROFILE_REF=secret://runtime/otel-tls-profile
# Same-origin Langfuse OTLP can omit endpoint/auth/TLS above and reuse Langfuse refs.
# [OPTIONAL] Standalone OTLP trace pipeline (TelemetryEngine, X2 — install the
# `[otel]` extra, or `[logfire]`, which carries opentelemetry-sdk transitively).
# Pure standard-env-var config alongside OTEL_EXPORTER_OTLP_ENDPOINT/
# OTEL_SERVICE_NAME (below `41.`) and EPISTEMIC_GRAPH_OBS_ADDR (below, self-ingest
# section) — unset stays a clean no-op (zero overhead), same as today. Point
# OTEL_EXPORTER_OTLP_ENDPOINT at a plain k8s Tempo/Alloy collector (e.g.
# http://alloy.observability.svc:4318) to enable it with no auth headers.
# OTEL_TRACES_EXPORTER=otlp                   # standard OTel var; "none" is a hard opt-out

# [OPTIONAL] Langfuse Observability Integration
# LANGFUSE_HOST=https://telemetry.example.test
# LANGFUSE_PUBLIC_KEY_REF=vault://observability/langfuse-public-key
# LANGFUSE_SECRET_KEY_REF=vault://observability/langfuse-secret-key
# LANGFUSE_PERSISTENCE_HMAC_KEY_REF=vault://observability/langfuse-persistence-hmac
# LANGFUSE_TLS_PROFILE_REF=vault://observability/langfuse-tls-profile
# LANGFUSE_CLIENT_CERT_REF=vault://observability/langfuse-client-certificate
# LANGFUSE_CLIENT_KEY_REF=vault://observability/langfuse-client-private-key
# LANGFUSE_CLIENT_KEY_PASSWORD_REF=vault://observability/langfuse-client-key-password
# LANGFUSE_DATASET_CAPTURE_THRESHOLD=0.0       # Capture score threshold for dataset creation
# LANGFUSE_LATENCY_BASELINE_SECONDS=60.0       # Alert baseline latency
# LANGFUSE_TOKEN_BASELINE=20000                # Expected token limit warning threshold
# LANGFUSE_VERIFIER_FALLBACK_LIMIT=1           # Retries before verification fallback

# Optional Google Workspace OAuth bootstrap. No tenant/client defaults ship in
# the codebase; provide both values through runtime/XDG configuration.
# GOOGLE_WORKSPACE_OAUTH_CLIENT_ID=
# GOOGLE_WORKSPACE_OAUTH_BROKER_URL=https://oauth-broker.example.test

# [OPTIONAL] Self-ingest telemetry (CONCEPT:KG-2.304 / AU-OS.observability.durable-telemetry-pipeline) — dogfooding
# Ship agent-utilities + graph-os's OWN logs (and RunTrace / ToolCall provenance)
# INTO the epistemic-graph engine's observability store over its OTLP/HTTP log
# endpoint (engine CONCEPT:EG-160). Opt-in + default-off: nothing is shipped
# unless AGENT_UTILITIES_SELF_INGEST is truthy AND EPISTEMIC_GRAPH_OBS_ADDR is set.
# Non-blocking (background batching thread). Once enabled the pipeline is
# durable + non-lossy by default: a failed send is requeued (bounded retries
# + backoff), backpressure/exhausted retries spill to a durable sqlite (WAL)
# buffer instead of vanishing, and every record is stamped with the ambient
# tenant/actor. The buffer itself being unavailable/at its bound is the one
# remaining loss case — always counted + logged loudly, never silent.
# AGENT_UTILITIES_SELF_INGEST=false            # Master opt-in switch (default off)
# EPISTEMIC_GRAPH_OBS_ADDR=https://observability.example.test # Engine obs endpoint base addr
# AGENT_UTILITIES_SELF_INGEST_MODE=otlp        # otlp → POST /v1/logs ; bulk → POST /_bulk
# AGENT_UTILITIES_SELF_INGEST_SERVICE=agent-utilities  # OTLP service.name
# AGENT_UTILITIES_SELF_INGEST_LEVEL=INFO       # Minimum log level to ship
# AGENT_UTILITIES_SELF_INGEST_BATCH=100        # Max records per batch
# AGENT_UTILITIES_SELF_INGEST_INTERVAL=2.0     # Background flush interval (seconds)
# AGENT_UTILITIES_SELF_INGEST_QUEUE_MAX=10000  # Bounded queue; overflow spills durably
# AGENT_UTILITIES_SELF_INGEST_TIMEOUT=3.0      # Per-request HTTP timeout (seconds)
# AGENT_UTILITIES_SELF_INGEST_MAX_RETRIES=3    # Resends before a batch spills durably
# AGENT_UTILITIES_SELF_INGEST_SPILL_PATH=      # Durable overflow sqlite path (default: XDG data dir)
# AGENT_UTILITIES_SELF_INGEST_SPILL_MAX=50000  # Durable buffer cap; beyond this = true drop

# [OPTIONAL] Fleet events webhook ingress (CONCEPT:OS-5.15)
# POST /api/fleet/events accepts Alertmanager v4 / Uptime Kuma / generic JSON
# webhooks, persists them as FleetEvent KG nodes and queues fleet_event_triage
# tasks. Alertmanager/Kuma can't mint JWTs, so an optional shared secret gates
# the endpoint instead. Unset = no token required.
# FLEET_EVENTS_TOKEN_REF=                      # Secret-provider reference

# [OPTIONAL] Autonomous evolution (docs/guides/autonomous-evolution.md)
# The daemon ticks are registered but OFF by default in code — turning a fleet
# autonomous is a DEPLOYMENT decision, made here, not a code default. The
# safety chain stays propose-only end-to-end unless auto-merge is also enabled:
# propose-only loops → governed validation (AHE-3.20) → regression gate → human merge.
# KG_LOOP=true                                 # Hourly propose-only research/self-evolution cycle
# KG_LOOP_INTERVAL=3600
# KG_LOOP_TOPICS=5
# KG_FAILURE_EVOLUTION=true                    # Langfuse failures → failure_gap topics → remediation proposals
# KG_FAILURE_EVOLUTION_INTERVAL=3600
# KG_ANOMALY_CONSUMER=true                     # Consume PerformanceAnomaly nodes → failure_gap topics (cheap, propose-only; default on)
# Governed auto-merge: proposal→active promotion gated by the production
# PromotionGovernanceValidator (SHACL + recorded regression gate + MergePolicy
# + constitution rules). Keep FALSE until you trust the proposal stream.
# KG_GOLDEN_AUTO_MERGE=false
# KG_GOLDEN_MERGE_THRESHOLD=0.85

# [OPTIONAL] Fleet autonomy control plane (docs/architecture/fleet_autonomy.md)
# Operational autonomy is policy-gated, never flag-only: every mutating action
# (restart/scale/deploy/rollback) passes the OS-5.24 ActionPolicy decision
# point. The shipped default policy keeps EVERYTHING mutating approval-required
# (queue at GET /api/fleet/approvals); relax per-rule via your own policy YAML
# or KG governance_rule overrides.
# ACTION_POLICY_PATH=                          # Empty = shipped conservative deploy/action-policy.default.yml
# FLEET_RECONCILER=true                        # Leader-only desired-state reconciler tick (OS-5.25; default off)
# FLEET_RECONCILER_INTERVAL=120
# FLEET_RECONCILER_MAX_ACTIONS=5               # Storm guard per tick
# FLEET_REGISTRY_PATH=                         # Empty = deploy/mcp-fleet.registry.yml
# FLEET_DESIRED_STATE_PATH=                    # Optional per-service replicas/desired/version override YAML
# FLEET_ACTUATOR=dryrun                        # dryrun (records intent only) | docker; Portainer wired via set_fleet_actuator()
# DEPLOY_WATCH_WINDOW=300                      # Health watch after deploy/restart (OS-5.27)
# DEPLOY_WATCH_POLL=15
# FLEET_AUTOSCALER=true                        # Leader-only reactive replica autoscaler tick (OS-5.29; default off)
# FLEET_AUTOSCALER_INTERVAL=60
# SCALING_PROMETHEUS_URL=                      # Empty = zero-infra in-process gauges; set http://prometheus:9090 for PromQL signals


# ───────────────────────────────────────────────────────────────────────────────
#  10. Agent-to-Agent (A2A) Discovery
# ───────────────────────────────────────────────────────────────────────────────
# [OPTIONAL] Standardized A2A communication parameters. Persistence is always
# the native Epistemic Graph plane; no alternate broker/storage URL exists.
# A2A_BROKER=epistemic_graph
# A2A_STORAGE=epistemic_graph
# A2A_BROKER_POLL_INTERVAL_MS=100
# A2A_BROKER_LEASE_MS=300000
# A2A_BROKER_PREFETCH=1
# A2A_BROKER_MESSAGE_TTL_MS=86400000
# A2A_BROKER_MAX_DELIVERY_COUNT=5
# A2A_MAX_PAYLOAD_BYTES=262144
# A2A_MAX_HISTORY=100
# A2A_MAX_ARTIFACTS=50
# A2A_MAX_CONTEXT_MESSAGES=100
# A2A_STORAGE_UPDATE_RETRIES=4
# A2A_DISPATCH_RECONCILE_INTERVAL_MS=1000
# A2A_DISPATCH_RECONCILE_LIMIT=64
# A2A_CANCELLATION_POLL_INTERVAL_MS=1000
# A2A_CONFIG=                                  # Path to external a2a_config.json
# A2A_REFRESH_INTERVAL=300                     # Period (sec) for card refresh


# ───────────────────────────────────────────────────────────────────────────────
#  11. Specialist Skills
# ───────────────────────────────────────────────────────────────────────────────
# [OPTIONAL] Loader paths for agent capabilities
# CUSTOM_SKILLS_DIRECTORY=                     # Custom skill packages folder
# SKILL_TYPES=                                 # Comma-separated list of active skill types

# [OPTIONAL] Optional-infra tool gates (default OFF — these toolsets need
# external services/credentials; opt in explicitly, see tools/tool_registry.py)
# X_TOOLS=0                                    # X/Grok social search via xAI (needs XAI_API_KEY); set 1 for production X use
# MEDIA_TOOLS=0                                # Media generation/transcription services
# DB_TOOLS=0                                   # Native database traversal tools


