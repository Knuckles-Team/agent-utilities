{
    "_comment": "Portable current-only AgentConfig example. Persist references, never secret material, endpoints, local paths, or customized source ontologies. Use setup-config and agent-utilities-doctor to generate and validate deployment-specific values outside the package.",
    "app_profile": "dev",
    "host": "127.0.0.1",
    "port": 9000,
    "debug": false,
    "enable_web_logs": false,
    "engine_lifecycle": "refcounted",
    "external_graph_connectors": [],
    "secrets_backend": "engine",
    "a2a_broker": "epistemic_graph",
    "a2a_storage": "epistemic_graph",
    "a2a_broker_poll_interval_ms": 100,
    "a2a_broker_lease_ms": 300000,
    "a2a_broker_prefetch": 1,
    "a2a_broker_message_ttl_ms": 86400000,
    "a2a_broker_max_delivery_count": 5,
    "a2a_max_payload_bytes": 262144,
    "a2a_max_history": 100,
    "a2a_max_artifacts": 50,
    "a2a_max_context_messages": 100,
    "a2a_storage_update_retries": 4,
    "a2a_dispatch_reconcile_interval_ms": 1000,
    "a2a_dispatch_reconcile_limit": 64,
    "a2a_cancellation_poll_interval_ms": 1000,
    "permissions_signing_key_ref": "env://AGENT_PERMISSION_AUTHORITY",
    "tool_guard_mode": "strict",
    "langfuse_public_key_ref": null,
    "langfuse_secret_key_ref": null,
    "langfuse_tls_profile_ref": null,
    "langfuse_capture_content": false,
    "kg_optimization_enabled": true
}
